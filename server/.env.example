# MongoDB Atlas connection string (Atlas -> Connect -> Drivers). Keep this file private; never commit .env
MONGODB_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/ipl_auction?retryWrites=true&w=majority
# Secret for admin-only endpoints (add/edit/delete players, edit mode presets). Choose a long random value.
ADMIN_KEY=change-me-to-a-long-random-string
PORT=4000
# Comma separated list of allowed frontend origins
CLIENT_ORIGIN=http://localhost:5173
# Insert teams, presets and the verified IPL 2026 players on boot (idempotent; set false to disable)
AUTO_SEED=true
# Development only, when no Atlas string is available: USE_MEMORY_DB=true
